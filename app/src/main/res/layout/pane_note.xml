<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView style="@style/Lbl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="0dp" android:text="Private notes for this project" />
    <EditText android:id="@+id/note" style="@style/Fld" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:hint="Package name, Play Console account, where the backup lives…" android:inputType="textMultiLine|textCapSentences" android:minLines="6" android:singleLine="false" />
    <TextView android:id="@+id/save" style="@style/BtnPri" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Save note" />
</LinearLayout>
