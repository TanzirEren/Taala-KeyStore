<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_code" android:scrollbars="none">
        <TextView android:id="@+id/code" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="12dp" android:tag="mono" android:textColor="?attr/cInk" android:textSize="12.5sp" />
    </HorizontalScrollView>
    <TextView android:id="@+id/copy" style="@style/Btn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
</LinearLayout>
