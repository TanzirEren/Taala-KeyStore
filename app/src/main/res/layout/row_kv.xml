<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <View android:id="@+id/divider" android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/cLine" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/k" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="?attr/cMute" android:textSize="13sp" />
        <TextView android:id="@+id/reveal" style="@style/Cp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reveal" />
        <TextView android:id="@+id/copy" style="@style/Cp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Copy" />
    </LinearLayout>
    <TextView android:id="@+id/code" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_code" android:ellipsize="end" android:maxLines="4" android:padding="10dp" android:tag="mono" android:textColor="?attr/cInk" android:textSize="13sp" />
</LinearLayout>
